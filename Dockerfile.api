# ── FastAPI serving image ────────────────────────────────────────────────────
# Serves SARIMA monthly ridership forecasts (P10/P50/P90) for BART stations.
# Each /forecast request fits SARIMA(0,1,1)(0,1,1,12) for one station from the
# committed feature store, using models/baselines/arima.py — the model and
# code the benchmark leaderboard ranks first. No forecast cache, no Chronos.
# Target: Google Cloud Run (linux/amd64)
#
# Build & push (Apple Silicon — MUST use Cloud Build, not local docker build):
#   gcloud builds submit --config=cloudbuild.yaml .
#   (a bare `--tag` build with no --config/-f defaults to the root
#   `Dockerfile`, NOT this one — cloudbuild.yaml is what selects
#   Dockerfile.api via its `-f Dockerfile.api` build arg.)
#
# Run locally (for testing only):
#   docker build -t transit-api -f Dockerfile.api .
#   docker run -it -p 8080:8080 transit-api

FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
  && rm -rf /var/lib/apt/lists/*

# Python deps — the serving layer plus statsmodels for SARIMA. scipy is pinned
# below 1.15: later releases deprecate the L-BFGS `disp` option statsmodels
# passes, and 1.18 removes it.
RUN pip install --no-cache-dir \
    fastapi==0.115.0 \
    "uvicorn[standard]==0.30.0" \
    pydantic==2.7.0 \
    pandas==2.2.0 \
    pyarrow==16.0.0 \
    numpy==1.26.4 \
    PyYAML==6.0.1 \
    scipy==1.14.1 \
    patsy==1.0.1 \
    statsmodels==0.14.4

# App source
COPY machine_learning_files/__init__.py   ./machine_learning_files/__init__.py
COPY machine_learning_files/api.py        ./machine_learning_files/api.py
COPY models/baselines/arima.py            ./models/baselines/arima.py

# Config
COPY configs/model.yaml ./configs/model.yaml

# Feature store (committed; see data/MANIFEST.md). The only data the API reads.
COPY data/processed/feature_store.parquet ./data/processed/feature_store.parquet

# Cloud Run injects PORT env var; default 8080
ENV PORT=8080

EXPOSE 8080

CMD ["sh", "-c", "uvicorn machine_learning_files.api:app --host 0.0.0.0 --port ${PORT:-8080}"]
