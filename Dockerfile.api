# ── FastAPI serving image ────────────────────────────────────────────────────
# Serves Chronos (chronos-t5-small) forecasts via REST API from cached parquet files,
# but this image ships NO forecast cache and does NOT include Chronos/AutoGluon, so
# /forecast returns 503 for known stations until a cache is provided in
# models/chronos2/outputs/ (known gap).
# Target: Google Cloud Run (linux/amd64)
#
# Build & push (Apple Silicon — MUST use Cloud Build, not local docker build):
#   gcloud builds submit --config=cloudbuild.yaml .
#   (a bare `--tag` build with no --config/-f defaults to the root
#   `Dockerfile`, NOT this one — cloudbuild.yaml is what selects
#   Dockerfile.api via its `-f Dockerfile.api` build arg.)
#
# Run locally (for testing only):
#   docker build -t transit-api -f Dockerfile.api .
#   docker run -it -p 8080:8080 transit-api

FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
  && rm -rf /var/lib/apt/lists/*

# Python deps — only what the serving layer needs (no Chronos/AutoGluon)
RUN pip install --no-cache-dir \
    fastapi==0.115.0 \
    "uvicorn[standard]==0.30.0" \
    pydantic==2.7.0 \
    pandas==2.2.0 \
    pyarrow==16.0.0 \
    numpy==1.26.4 \
    PyYAML==6.0.1

# App source
COPY machine_learning_files/__init__.py   ./machine_learning_files/__init__.py
COPY machine_learning_files/api.py        ./machine_learning_files/api.py
COPY machine_learning_files/zero_shot.py  ./machine_learning_files/zero_shot.py

# Config
COPY configs/model.yaml ./configs/model.yaml

# Feature-store data copied into the image
COPY data/processed/feature_store_enriched.parquet ./data/processed/feature_store_enriched.parquet
COPY data/processed/feature_store.parquet          ./data/processed/feature_store.parquet
# models/chronos2/outputs/ is NOT copied: the directory does not exist in the
# repository, and a COPY of a missing path fails the build. It was only ever
# produced by a local zero_shot.py run, and nothing committed depends on it —
# api.py tries live inference when cached forecasts are absent, but this image
# installs no chronos-forecasting, so /forecast returns 503 for a known station
# (unknown station: 404).
# Re-add this line only alongside a step that actually creates the directory.

# Cloud Run injects PORT env var; default 8080
ENV PORT=8080

EXPOSE 8080

CMD ["sh", "-c", "uvicorn machine_learning_files.api:app --host 0.0.0.0 --port ${PORT:-8080}"]
