# Controls what gets uploaded to Cloud Build (gcloud builds submit).
# IMPORTANT: data/processed/ is intentionally NOT listed here — Dockerfile.api
# COPYs the committed data/processed/feature_store.parquet into the image.
.git
.venv
.venv311
__pycache__
*.pyc
*.pyo
node_modules
# Dockerfile.assistant needs website/data (three JSON files); the rest of website/ stays out.
website/*
!website/data
Final_eda
transit_eda
.firebase
.claude
.agents
skills-lock.json
*.log
